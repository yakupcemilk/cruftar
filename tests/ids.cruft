package ids_test

import cli

pub fn main(): i32
    if cli.template_id("pure-cruft".data(), 10) != 1 then
        ret 1
    end
    if cli.template_id("cruft-with-c".data(), 12) != 2 then
        ret 1
    end
    if cli.template_id("cruft-with-rust".data(), 15) != 3 then
        ret 1
    end
    if cli.template_id("nope".data(), 4) != 0 then
        ret 1
    end
    if cli.target_id("cli".data(), 3) != 1 then
        ret 1
    end
    if cli.target_id("lib".data(), 3) != 2 then
        ret 1
    end
    if cli.target_id("gui".data(), 3) != 3 then
        ret 1
    end
    if cli.target_id("wasm".data(), 4) != 4 then
        ret 1
    end
    if cli.menu_step(0, 3, 2) != 1 then
        ret 1
    end
    if cli.menu_step(0, 3, 1) != 0 then
        ret 1
    end
    if cli.menu_step(1, 3, 3) != 101 then
        ret 1
    end
    if cli.menu_step(0, 4, 11) != 1 then
        ret 1
    end
    if cli.menu_step(2, 4, 4) != -1 then
        ret 1
    end
    ret 0
end
