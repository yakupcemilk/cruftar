pub fn gen_c(target: i32): i32
    if target == 1 then
        host.host_slot_concat(S_IDENT, "_cli".data(), S_HELPER)
        if emit_main_call(".run()\nend\n".data()) != 0 then
            ret 1
        end
        if emit_c_cli() != 0 then
            ret 1
        end
        if emit_args_c() != 0 then
            ret 1
        end
        ret emit_code_test("command_code(0) != 0".data(), "command_code(1) != 1".data())
    end
    if target == 2 or target == 4 then
        host.host_slot_concat(S_IDENT, "_num".data(), S_HELPER)
        if target == 2 then
            if emit_num_lib("cruft_add".data()) != 0 then
                ret 1
            end
        else
            if emit_num_main("cruft_add".data()) != 0 then
                ret 1
            end
        end
        if emit_add_c() != 0 then
            ret 1
        end
        ret emit_sum_test()
    end
    host.host_slot_concat(S_IDENT, "_gui".data(), S_HELPER)
    if emit_main_call(".open_default()\nend\n".data()) != 0 then
        ret 1
    end
    if emit_gui_cruft() != 0 then
        ret 1
    end
    if emit_gui_c() != 0 then
        ret 1
    end
    ret emit_call_test("open_default()".data())
end

pub fn emit_c_cli(): i32
    save_helper_path()
    host.host_buf_puts("package ".data())
    host.host_buf_puts_slot(S_HELPER)
    host.host_buf_puts("\n\nimport io\n\nextern fn cruft_argc(): i32\nextern fn cruft_wants_help(): i32\n\n".data())
    host.host_buf_puts("pub fn command_code(help: i32): i32\n    if help != 0 then\n        ret 1\n    end\n    ret 0\nend\n\n".data())
    host.host_buf_puts("pub fn run(): i32\n    if cruft_wants_help() != 0 then\n        io.println(\"usage: app [-h]\")\n        ret 0\n    end\n    io.print(\"args=\")\n    print(cruft_argc())\n    ret command_code(0)\nend\n".data())
    ret emit_slot(S_SAVED)
end

pub fn emit_args_c(): i32
    host.host_buf_clear()
    host.host_buf_puts("#ifndef CRUFT_ARGS_H\n#define CRUFT_ARGS_H\nint cruft_argc(void);\nint cruft_wants_help(void);\n#endif\n".data())
    if emit_rel("src/runtime/args.h".data()) != 0 then
        ret 1
    end
    host.host_buf_clear()
    host.host_buf_puts("#include \"args.h\"\n#ifdef _WIN32\n#include <windows.h>\nint cruft_argc(void) {\n    int argc = 0;\n    LPWSTR *argv = CommandLineToArgvW(GetCommandLineW(), &argc);\n    if (argv == 0) return 0;\n    LocalFree(argv);\n    return argc;\n}\n".data())
    host.host_buf_puts("int cruft_wants_help(void) {\n    int argc = 0;\n    int i;\n    LPWSTR *argv = CommandLineToArgvW(GetCommandLineW(), &argc);\n    if (argv == 0) return 0;\n    for (i = 1; i < argc; i++) {\n        if (lstrcmpW(argv[i], L\"-h\") == 0 || lstrcmpW(argv[i], L\"--help\") == 0) {\n            LocalFree(argv);\n            return 1;\n        }\n    }\n    LocalFree(argv);\n    return 0;\n}\n#else\nint cruft_argc(void) { return 1; }\nint cruft_wants_help(void) { return 0; }\n#endif\n".data())
    ret emit_rel("src/runtime/args.c".data())
end

pub fn emit_add_c(): i32
    host.host_buf_clear()
    host.host_buf_puts("#ifndef CRUFT_ADD_H\n#define CRUFT_ADD_H\nint cruft_add(int a, int b);\n#endif\n".data())
    if emit_rel("src/runtime/add.h".data()) != 0 then
        ret 1
    end
    host.host_buf_clear()
    host.host_buf_puts("#include \"add.h\"\nint cruft_add(int a, int b) { return a + b; }\n".data())
    ret emit_rel("src/runtime/add.c".data())
end

pub fn emit_gui_c(): i32
    host.host_buf_clear()
    host.host_buf_puts("#ifndef CRUFT_GUI_WINDOW_H\n#define CRUFT_GUI_WINDOW_H\nint cruft_gui_open(int width, int height);\nint cruft_gui_close(void);\n#endif\n".data())
    if emit_rel("src/runtime/gui_window.h".data()) != 0 then
        ret 1
    end
    host.host_buf_clear()
    host.host_buf_puts("#include \"gui_window.h\"\n#include <stdio.h>\nint cruft_gui_open(int width, int height) {\n    if (width <= 0 || height <= 0) return 0;\n    printf(\"gui scaffold %d %d\\n\", width, height);\n    return 1;\n}\nint cruft_gui_close(void) { return 0; }\n".data())
    ret emit_rel("src/runtime/gui_window.c".data())
end

pub fn emit_gui_cruft(): i32
    save_helper_path()
    host.host_buf_puts("package ".data())
    host.host_buf_puts_slot(S_HELPER)
    host.host_buf_puts("\n\nextern fn cruft_gui_open(width: i32, height: i32): i32\nextern fn cruft_gui_close(): i32\n\n".data())
    host.host_buf_puts("pub fn open_default(): i32\n    var opened: i32 = cruft_gui_open(64, 32)\n    if opened == 0 then\n        ret 1\n    end\n    ret cruft_gui_close()\nend\n".data())
    ret emit_slot(S_SAVED)
end

pub fn emit_num_lib(extern_name: ptr): i32
    host.host_buf_clear()
    host.host_buf_puts("package ".data())
    host.host_buf_puts_slot(S_IDENT)
    host.host_buf_puts("\n\nimport ".data())
    host.host_buf_puts_slot(S_HELPER)
    host.host_buf_puts("\n\nexport ".data())
    host.host_buf_puts_slot(S_HELPER)
    host.host_buf_puts(".add\n\npub fn sum(a: i32, b: i32): i32\n    ret ".data())
    host.host_buf_puts_slot(S_HELPER)
    host.host_buf_puts(".add(a, b)\nend\n\npri fn hidden(): i32\n    ret 0\nend\n".data())
    if emit_rel("src/lib.cruft".data()) != 0 then
        ret 1
    end
    ret emit_num_helper(extern_name)
end

pub fn emit_num_main(extern_name: ptr): i32
    if emit_wasm_main(".add(20, 22)".data()) != 0 then
        ret 1
    end
    ret emit_num_helper(extern_name)
end

pub fn emit_num_helper(extern_name: ptr): i32
    save_helper_path()
    host.host_buf_puts("package ".data())
    host.host_buf_puts_slot(S_HELPER)
    host.host_buf_puts("\n\nextern fn ".data())
    host.host_buf_puts(extern_name)
    host.host_buf_puts("(a: i32, b: i32): i32\n\npub fn add(a: i32, b: i32): i32\n    ret ".data())
    host.host_buf_puts(extern_name)
    host.host_buf_puts("(a, b)\nend\n".data())
    ret emit_slot(S_SAVED)
end

