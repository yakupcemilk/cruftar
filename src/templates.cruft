package cli

import host
import fs
import io

pub fn write_project(template: i32, target: i32): i32
    prepare_new(template, target)
    render_manifest()
    if emit_rel("cruft.toml".data()) != 0 then
        ret 1
    end
    if emit_ignore() != 0 then
        ret 1
    end
    if emit_readme(template, target) != 0 then
        ret 1
    end
    if template == 1 then
        ret gen_pure(target)
    end
    if template == 2 then
        ret gen_c(target)
    end
    ret gen_rust(target)
end

pub fn emit_init_main(): i32
    host.host_buf_clear()
    host.host_buf_puts("package ".data())
    host.host_buf_puts_slot(S_IDENT)
    host.host_buf_puts("\n\nimport io\n\n".data())
    put_entry()
    host.host_buf_puts("    io.println(\"hello\")\n    ret 0\nend\n".data())
    ret emit_rel("src/main.cruft".data())
end

pub fn emit_rel(rel: ptr): i32
    host.host_slot_set_cstr(S_TEMP, rel)
    ret emit_slot(S_TEMP)
end

pub fn emit_slot(rel: i32): i32
    host.host_join_cstr(S_ROOT, host.host_slot_ptr(rel), S_PATH)
    host.host_dirname_to(host.host_slot_ptr(S_PATH), host.host_slot_len(S_PATH), S_SAVED)
    host.host_mkdirs(host.host_slot_ptr(S_SAVED))
    var body: String = host.take()
    host.host_buf_clear()
    var path: String = host.slot_string(S_PATH)
    if not fs.write_file(path, body) then
        ret 1
    end
    ret 0
end

pub fn put_entry()
    host.host_buf_puts("pub fn ".data())
    host.host_buf_puts("main(): i32\n".data())
end

pub fn emit_ignore(): i32
    host.host_buf_clear()
    host.host_buf_puts("/build/\n*.o\n*.ll\n*.s\n*.exe\n/rust/target/\n".data())
    ret emit_rel(".gitignore".data())
end

pub fn emit_readme(template: i32, target: i32): i32
    host.host_buf_clear()
    host.host_buf_puts("# ".data())
    host.host_buf_puts_slot(S_NAME)
    host.host_buf_puts("\n\nCruft project generated by cruftar.\n\n- template: `".data())
    host.host_buf_puts_slot(S_TEMPLATE)
    host.host_buf_puts("`\n- target: `".data())
    host.host_buf_puts_slot(S_TARGET)
    host.host_buf_puts("`\n- package: `".data())
    host.host_buf_puts_slot(S_IDENT)
    host.host_buf_puts("`\n- entry: `".data())
    host.host_buf_puts_slot(S_ENTRY)
    host.host_buf_puts("`\n\n## Build\n\n```powershell\ncruftar check\ncruftar build\ncruftar test\n```\n\n".data())
    host.host_buf_puts("`cruftar build` runs `cruftc --check`, then `-emit-llvm`, then `-c`.\n".data())
    host.host_buf_puts("Host binaries are linked with gcc or clang and the compiler runtime.\n\n".data())
    if target == 2 then
        host.host_buf_puts("This is a library. The entry has no process entry point. `cruftar test` compiles tests/*.cruft, which supply one.\n\n".data())
    end
    if target == 4 then
        host.host_buf_puts("## WebAssembly\n\n`[target] triple` is `wasm32-unknown-unknown`. cruftc forwards that LLVM triple. There is no WASI or browser API. `cruftar build` stops after the object file. Tests still run on the host.\n\n".data())
    end
    if target == 3 and template == 1 then
        host.host_buf_puts("## Windowing\n\nThis pure template draws a text frame with std/io. It does not open a native window.\n\n".data())
    end
    if target == 3 and template != 1 then
        host.host_buf_puts("## Windowing\n\n`cruft_gui_open` / `cruft_gui_close` are a scaffold. They do not open a real window. Link a window library later with `cruftar add c:raylib`.\n\n".data())
    end
    if template == 2 then
        host.host_buf_puts("## C runtime\n\n`src/runtime/` holds the C ABI stub. `cruftar build` compiles every `.c` file there into the host link.\n\n".data())
    end
    if template == 3 then
        host.host_buf_puts("## Rust staticlib\n\n`rust/` is a Cargo staticlib with `#[no_mangle] extern \"C\"` exports. `cruftar build` runs `cargo build --release` when the host executable needs it.\n\n".data())
    end
    host.host_buf_puts("## Tests\n\nEach file under `tests/` is a program. A non-zero return fails the test.\n".data())
    ret emit_rel("README.md".data())
end

pub fn emit_main_call(tail: ptr): i32
    host.host_buf_clear()
    host.host_buf_puts("package ".data())
    host.host_buf_puts_slot(S_IDENT)
    host.host_buf_puts("\n\nimport ".data())
    host.host_buf_puts_slot(S_HELPER)
    host.host_buf_puts("\n\n".data())
    put_entry()
    host.host_buf_puts("    ret ".data())
    host.host_buf_puts_slot(S_HELPER)
    host.host_buf_puts(tail)
    ret emit_rel("src/main.cruft".data())
end

pub fn save_helper_path()
    host.host_buf_clear()
    host.host_buf_puts("src/".data())
    host.host_buf_puts_slot(S_HELPER)
    host.host_buf_puts(".cruft".data())
    host.host_slot_set(S_SAVED, host.host_buf_ptr(), host.host_buf_len())
    host.host_buf_clear()
end

pub fn gen_pure(target: i32): i32
    if target == 1 then
        host.host_slot_concat(S_IDENT, "_greet".data(), S_HELPER)
        if emit_main_call(".run(0)\nend\n".data()) != 0 then
            ret 1
        end
        save_helper_path()
        host.host_buf_puts("package ".data())
        host.host_buf_puts_slot(S_HELPER)
        host.host_buf_puts("\n\nimport io\n\n// command 1 prints usage. Any other code prints a greeting.\n".data())
        host.host_buf_puts("pub fn run(command: i32): i32\n    if command == 1 then\n        io.println(\"usage: app\")\n        ret 0\n    end\n    io.println(\"hello\")\n    ret 0\nend\n".data())
        if emit_slot(S_SAVED) != 0 then
            ret 1
        end
        ret emit_pure_cli_rest()
    end
    if target == 2 then
        host.host_slot_concat(S_IDENT, "_prelude".data(), S_HELPER)
        if emit_pure_lib() != 0 then
            ret 1
        end
        ret emit_lib_rest()
    end
    if target == 3 then
        host.host_slot_concat(S_IDENT, "_frame".data(), S_HELPER)
        if emit_main_call(".draw()\nend\n".data()) != 0 then
            ret 1
        end
        save_helper_path()
        host.host_buf_puts("package ".data())
        host.host_buf_puts_slot(S_HELPER)
        host.host_buf_puts("\n\nimport io\n\npub fn draw(): i32\n    io.println(\"+------+\")\n    io.println(\"| cruft|\")\n    io.println(\"+------+\")\n    ret 0\nend\n".data())
        if emit_slot(S_SAVED) != 0 then
            ret 1
        end
        ret emit_call_test("draw()".data())
    end
    host.host_slot_concat(S_IDENT, "_answer".data(), S_HELPER)
    if emit_wasm_main(".value()".data()) != 0 then
        ret 1
    end
    save_helper_path()
    host.host_buf_puts("package ".data())
    host.host_buf_puts_slot(S_HELPER)
    host.host_buf_puts("\n\npub fn value(): i32\n    ret 42\nend\n".data())
    if emit_slot(S_SAVED) != 0 then
        ret 1
    end
    ret emit_value_test()
end

pub fn emit_pure_cli_rest(): i32
    host.host_buf_clear()
    host.host_buf_puts("package ".data())
    host.host_buf_puts_slot(S_IDENT)
    host.host_buf_puts("_check\n\nimport ".data())
    host.host_buf_puts_slot(S_HELPER)
    host.host_buf_puts("\n\n".data())
    put_entry()
    host.host_buf_puts("    if ".data())
    host.host_buf_puts_slot(S_HELPER)
    host.host_buf_puts(".run(0) != 0 then\n        ret 1\n    end\n    if ".data())
    host.host_buf_puts_slot(S_HELPER)
    host.host_buf_puts(".run(1) != 0 then\n        ret 1\n    end\n    ret 0\nend\n".data())
    if emit_rel("tests/check.cruft".data()) != 0 then
        ret 1
    end
    host.host_buf_clear()
    host.host_buf_puts("package example\n\nimport io\n\n".data())
    put_entry()
    host.host_buf_puts("    io.println(\"hello\")\n    ret 0\nend\n".data())
    ret emit_rel("examples/hello.cruft".data())
end

