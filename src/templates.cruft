end

pub fn gen_rust(target: i32): i32
    if target == 1 then
        host.host_slot_concat(S_IDENT, "_cli".data(), S_HELPER)
        if emit_main_call(".run()\nend\n".data()) != 0 then
            ret 1
        end
        if emit_rust_cli() != 0 then
            ret 1
        end
        if emit_cargo(0) != 0 then
            ret 1
        end
        ret emit_code_test("command_code(0) != 0".data(), "command_code(1) != 1".data())
    end
    if target == 2 or target == 4 then
        host.host_slot_concat(S_IDENT, "_num".data(), S_HELPER)
        if target == 2 then
            if emit_num_lib("cruft_rust_add".data()) != 0 then
                ret 1
            end
        else
            if emit_num_main("cruft_rust_add".data()) != 0 then
                ret 1
            end
        end
        if emit_cargo(1) != 0 then
            ret 1
        end
        ret emit_sum_test()
    end
    host.host_slot_concat(S_IDENT, "_gui".data(), S_HELPER)
    if emit_main_call(".open_default()\nend\n".data()) != 0 then
        ret 1
    end
    if emit_gui_cruft() != 0 then
        ret 1
    end
    if emit_cargo(2) != 0 then
        ret 1
    end
    ret emit_call_test("open_default()".data())
end

pub fn emit_rust_cli(): i32
    save_helper_path()
    host.host_buf_puts("package ".data())
    host.host_buf_puts_slot(S_HELPER)
    host.host_buf_puts("\n\nimport io\n\nextern fn cruft_rust_argc(): i32\nextern fn cruft_rust_wants_help(): i32\n\n".data())
    host.host_buf_puts("pub fn command_code(help: i32): i32\n    if help != 0 then\n        ret 1\n    end\n    ret 0\nend\n\n".data())
    host.host_buf_puts("pub fn run(): i32\n    if cruft_rust_wants_help() != 0 then\n        io.println(\"usage: app [-h]\")\n        ret 0\n    end\n    io.print(\"args=\")\n    print(cruft_rust_argc())\n    ret command_code(0)\nend\n".data())
    ret emit_slot(S_SAVED)
end

pub fn emit_cargo(kind: i32): i32
    host.host_buf_clear()
    host.host_buf_puts("[package]\nname = \"cruft_bridge\"\nversion = \"0.1.0\"\nedition = \"2021\"\n\n[lib]\nname = \"cruft_bridge\"\npath = \"src/lib.rs\"\ncrate-type = [\"staticlib\"]\n\n[profile.dev]\npanic = \"abort\"\n\n[profile.release]\npanic = \"abort\"\n".data())
    if emit_rel("rust/Cargo.toml".data()) != 0 then
        ret 1
    end
    host.host_buf_clear()
    if kind == 0 then
        host.host_buf_puts("#[no_mangle]\npub extern \"C\" fn cruft_rust_argc() -> i32 {\n    std::env::args().count() as i32\n}\n\n#[no_mangle]\npub extern \"C\" fn cruft_rust_wants_help() -> i32 {\n    for arg in std::env::args().skip(1) {\n        if arg == \"-h\" || arg == \"--help\" { return 1; }\n    }\n    0\n}\n".data())
    end
    if kind == 1 then
        host.host_buf_puts("#![no_std]\n#[panic_handler]\nfn panic(_info: &core::panic::PanicInfo) -> ! { loop {} }\n\n#[no_mangle]\npub extern \"C\" fn cruft_rust_add(a: i32, b: i32) -> i32 { a + b }\n".data())
    end
    if kind == 2 then
        host.host_buf_puts("#[no_mangle]\npub extern \"C\" fn cruft_gui_open(width: i32, height: i32) -> i32 {\n    if width <= 0 || height <= 0 { return 0; }\n    println!(\"gui scaffold {width} {height}\");\n    1\n}\n\n#[no_mangle]\npub extern \"C\" fn cruft_gui_close() -> i32 { 0 }\n".data())
    end
    ret emit_rel("rust/src/lib.rs".data())
end
