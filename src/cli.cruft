package cli

import host
import io

// Slots. Toolchain and paths stay below the manifest fields so parsing can
// clear the manifest without forgetting --cruftc or the project root.
const S_CRUFTC: i32 = 0
const S_STD: i32 = 1
const S_CC: i32 = 2
const S_RUNTIME: i32 = 3
const S_CARGO: i32 = 4
const S_ROOT: i32 = 5
const S_PATH: i32 = 6
const S_NAME: i32 = 7
const S_VERSION: i32 = 8
const S_KIND: i32 = 9
const S_TEMPLATE: i32 = 10
const S_TARGET: i32 = 11
const S_ENTRY: i32 = 12
const S_TRIPLE: i32 = 13
const S_DEVOPT: i32 = 14
const S_RELOPT: i32 = 15
const S_OPT: i32 = 16
const S_STDFIELD: i32 = 17
const S_EDITION: i32 = 18
const S_IDENT: i32 = 19
const S_HELPER: i32 = 20
const S_KEY: i32 = 21
const S_VALUE: i32 = 22
const S_SAVED: i32 = 23
const S_RUSTLIB: i32 = 24
const S_OUT: i32 = 25
const S_TEMP: i32 = 26
const S_COMPILER: i32 = 27
const S_MANIFEST: i32 = 28
const S_ARG: i32 = 29
const S_FLAG_TEMPLATE: i32 = 30
const S_FLAG_TARGET: i32 = 31
const S_FLAG_LIB: i32 = 32
const S_FLAG_SEARCH: i32 = 33
const S_HOLD: i32 = 35

const L_LIBS: i32 = 0
const L_SEARCH: i32 = 1
const L_MODULES: i32 = 2
const L_DEP_NAME: i32 = 3
const L_DEP_SRC: i32 = 4
const L_SOURCES: i32 = 5
const L_TESTS: i32 = 6
const L_CFILES: i32 = 7
const L_ARGS: i32 = 8
const L_COMPILE: i32 = 9

var g_cmd: i32 = 0
var g_release: i32 = 0
var g_force: i32 = 0
var g_pos: i32 = 0
var g_help: i32 = 0
var g_passthru: i32 = 0
var g_opt: i32 = 0

pub fn run(): i32
    host.host_init()
    host.host_getcwd(S_ROOT)
    if host.host_argc() < 2 then
        help_text()
        ret 0
    end
    ret dispatch()
end

pub fn template_id(p: ptr, n: i64): i32
    if host.eq(p, n, "pure-cruft") != 0 then
        ret 1
    end
    if host.eq(p, n, "cruft-with-c") != 0 then
        ret 2
    end
    if host.eq(p, n, "cruft-with-rust") != 0 then
        ret 3
    end
    ret 0
end

pub fn target_id(p: ptr, n: i64): i32
    if host.eq(p, n, "cli") != 0 then
        ret 1
    end
    if host.eq(p, n, "lib") != 0 then
        ret 2
    end
    if host.eq(p, n, "gui") != 0 then
        ret 3
    end
    if host.eq(p, n, "wasm") != 0 then
        ret 4
    end
    ret 0
end

pub fn menu_step(sel: i32, count: i32, key: i32): i32
    if key == 1 then
        if sel > 0 then
            var up: i32 = sel - 1
            ret up
        end
        ret sel
    end
    if key == 2 then
        var down: i32 = sel + 1
        if down < count then
            ret down
        end
        ret sel
    end
    if key == 3 then
        var entered: i32 = 100 + sel
        ret entered
    end
    if key == 4 then
        ret -1
    end
    if key >= 10 then
        var pick: i32 = key - 10
        if pick >= 0 and pick < count then
            ret pick
        end
    end
    ret sel
end

pub fn dispatch(): i32
    var cmd: String = host.arg(1)
    if host.eq(cmd.data(), cmd.byte_len(), "help") != 0 or host.eq(cmd.data(), cmd.byte_len(), "--help") != 0 or host.eq(cmd.data(), cmd.byte_len(), "-h") != 0 then
        help_text()
        ret 0
    end
    if host.eq(cmd.data(), cmd.byte_len(), "--version") != 0 or host.eq(cmd.data(), cmd.byte_len(), "version") != 0 or host.eq(cmd.data(), cmd.byte_len(), "-V") != 0 then
        io.println("cruftar 0.1.0")
        ret 0
    end
    if host.eq(cmd.data(), cmd.byte_len(), "new") != 0 then
        g_cmd = 1
    else
        if host.eq(cmd.data(), cmd.byte_len(), "init") != 0 then
            g_cmd = 2
        else
            if host.eq(cmd.data(), cmd.byte_len(), "build") != 0 then
                g_cmd = 3
            else
                if host.eq(cmd.data(), cmd.byte_len(), "run") != 0 then
                    g_cmd = 4
                else
                    if host.eq(cmd.data(), cmd.byte_len(), "check") != 0 then
                        g_cmd = 5
                    else
                        if host.eq(cmd.data(), cmd.byte_len(), "test") != 0 then
                            g_cmd = 6
                        else
                            if host.eq(cmd.data(), cmd.byte_len(), "add") != 0 then
                                g_cmd = 7
                            else
                                if host.eq(cmd.data(), cmd.byte_len(), "clean") != 0 then
                                    g_cmd = 8
                                else
                                    usage_unknown()
                                    ret 2
                                end
                            end
                        end
                    end
                end
            end
        end
    end
    var parsed: i32 = parse_args()
    if parsed != 0 then
        ret parsed
    end
    if g_help != 0 then
        help_text()
        ret 0
    end
    if g_cmd == 1 then
        ret cmd_new()
    end
    if g_cmd == 2 then
        ret cmd_init()
    end
    if g_cmd == 3 then
        ret cmd_build()
    end
    if g_cmd == 4 then
        ret cmd_run()
    end
    if g_cmd == 5 then
        ret cmd_check()
    end
    if g_cmd == 6 then
        ret cmd_test()
    end
    if g_cmd == 7 then
        ret cmd_add()
    end
    if g_cmd == 8 then
        ret cmd_clean()
    end
    ret 2
end

pub fn parse_args(): i32
    var n: i32 = host.host_argc()
    var i: i32 = 2
    while i < n do
        var step: i32 = consume(i)
        if step < 0 then
            ret 2
        end
        i = i + step
    end
    ret 0
end

pub fn consume(i: i32): i32
    var a: String = host.arg(i)
    if g_passthru != 0 then
        host.host_list_add(L_ARGS, a.data(), a.byte_len())
        ret 1
    end
    if host.eq(a.data(), a.byte_len(), "--") != 0 then
        g_passthru = 1
        ret 1
    end
    if host.eq(a.data(), a.byte_len(), "--help") != 0 or host.eq(a.data(), a.byte_len(), "-h") != 0 then
        g_help = 1
        ret 1
    end
    if host.eq(a.data(), a.byte_len(), "--force") != 0 then
        g_force = 1
        ret 1
    end
    if host.eq(a.data(), a.byte_len(), "--release") != 0 then
        g_release = 1
        ret 1
    end
    if host.eq(a.data(), a.byte_len(), "--template") != 0 then
        ret take_flag(i, S_FLAG_TEMPLATE)
    end
    if host.eq(a.data(), a.byte_len(), "--target") != 0 then
        ret take_flag(i, S_FLAG_TARGET)
    end
    if host.eq(a.data(), a.byte_len(), "--cruftc") != 0 then
        ret take_flag(i, S_CRUFTC)
    end
    if host.eq(a.data(), a.byte_len(), "--lib") != 0 then
        ret take_flag(i, S_FLAG_LIB)
    end
    if host.eq(a.data(), a.byte_len(), "--search") != 0 then
        ret take_flag(i, S_FLAG_SEARCH)
    end
    if host.host_starts(a.data(), a.byte_len(), "-".data()) != 0 then
        usage_unknown()
        ret -1
    end
    if g_pos != 0 then
        usage_extra()
        ret -1
    end
    g_pos = 1
    host.host_slot_set(S_ARG, a.data(), a.byte_len())
    ret 1
end

pub fn take_flag(i: i32, slot: i32): i32
    var n: i32 = host.host_argc()
    var next: i32 = i + 1
    if next >= n then
        usage_value()
        ret -1
    end
    var v: String = host.arg(next)
    host.host_slot_set(slot, v.data(), v.byte_len())
    ret 2
end

pub fn cmd_new(): i32
    if host.host_slot_len(S_ARG) == 0 then
        usage_new()
        ret 2
    end
    host.host_basename_to(host.host_slot_ptr(S_ARG), host.host_slot_len(S_ARG), S_NAME)
    if host.host_valid_name(host.host_slot_ptr(S_NAME), host.host_slot_len(S_NAME)) == 0 then
        usage_name()
        ret 2
    end
    var choice: i32 = resolve_choice()
    if choice != 0 then
        ret choice
    end
    var template: i32 = template_id(host.host_slot_ptr(S_FLAG_TEMPLATE), host.host_slot_len(S_FLAG_TEMPLATE))
    var target: i32 = target_id(host.host_slot_ptr(S_FLAG_TARGET), host.host_slot_len(S_FLAG_TARGET))
    host.host_join_cstr(S_ROOT, host.host_slot_ptr(S_ARG), S_PATH)
    var state: i32 = host.host_dir_state(host.host_slot_ptr(S_PATH))
    if state < 0 then
        say_fixed("destination exists and is not a directory")
        ret 1
    end
    if state == 0 and g_force == 0 then
        say_fixed("destination already exists and is not empty. Pass --force to overwrite generated files")
        ret 1
    end
    host.host_slot_copy(S_ROOT, S_PATH)
    if host.host_mkdirs(host.host_slot_ptr(S_ROOT)) == 0 then
        say_fixed("cannot create the project directory")
        ret 1
    end
    host.host_make_ident(host.host_slot_ptr(S_NAME), host.host_slot_len(S_NAME), S_IDENT)
    if write_project(template, target) != 0 then
        say_fixed("cannot write the project files")
        ret 1
    end
    note_created()
    ret 0
end

pub fn cmd_init(): i32
    host.host_join_cstr(S_ROOT, "cruft.toml".data(), S_PATH)
    if host.host_is_file(host.host_slot_ptr(S_PATH)) != 0 and g_force == 0 then
        say_fixed("cruft.toml already exists. Pass --force to overwrite it")
        ret 1
    end
    host.host_basename_to(host.host_slot_ptr(S_ROOT), host.host_slot_len(S_ROOT), S_NAME)
    if host.host_valid_name(host.host_slot_ptr(S_NAME), host.host_slot_len(S_NAME)) == 0 then
        host.host_slot_set_cstr(S_NAME, "app".data())
    end
    host.host_make_ident(host.host_slot_ptr(S_NAME), host.host_slot_len(S_NAME), S_IDENT)
    prepare_new(1, 1)
    if write_manifest_slot(S_PATH) != 0 then
        say_fixed("cannot write cruft.toml")
        ret 1
    end
    host.host_join_cstr(S_ROOT, "src/main.cruft".data(), S_OUT)
    if host.host_is_file(host.host_slot_ptr(S_OUT)) == 0 then
        if emit_init_main() != 0 then
            say_fixed("cannot write src/main.cruft")
            ret 1
        end
    end
    io.println("initialized cruft.toml")
    ret 0
end

pub fn cmd_add(): i32
    if host.host_slot_len(S_ARG) == 0 and host.host_slot_len(S_FLAG_LIB) == 0 and host.host_slot_len(S_FLAG_SEARCH) == 0 then
        usage_add()
        ret 2
    end
    if load_project() != 0 then
        ret 1
    end
    if host.host_slot_len(S_ARG) > 0 then
        var added: i32 = apply_token(host.host_slot_ptr(S_ARG), host.host_slot_len(S_ARG))
        if added != 0 then
            ret added
        end
    end
    if host.host_slot_len(S_FLAG_LIB) > 0 then
        if host.host_valid_lib(host.host_slot_ptr(S_FLAG_LIB), host.host_slot_len(S_FLAG_LIB)) == 0 then
            usage_lib()
            ret 2
        end
        add_lib(host.host_slot_ptr(S_FLAG_LIB), host.host_slot_len(S_FLAG_LIB))
    end
    if host.host_slot_len(S_FLAG_SEARCH) > 0 then
        add_search(host.host_slot_ptr(S_FLAG_SEARCH), host.host_slot_len(S_FLAG_SEARCH))
    end
    host.host_join_cstr(S_ROOT, "cruft.toml".data(), S_PATH)
    if write_manifest_slot(S_PATH) != 0 then
        say_fixed("cannot write cruft.toml")
        ret 1
    end
    ret 0
end

pub fn resolve_choice(): i32
    var have_template: i32 = 0
    var have_target: i32 = 0
    if host.host_slot_len(S_FLAG_TEMPLATE) > 0 then
        if template_id(host.host_slot_ptr(S_FLAG_TEMPLATE), host.host_slot_len(S_FLAG_TEMPLATE)) == 0 then
            usage_template()
            ret 2
        end
        have_template = 1
    end
    if host.host_slot_len(S_FLAG_TARGET) > 0 then
        if target_id(host.host_slot_ptr(S_FLAG_TARGET), host.host_slot_len(S_FLAG_TARGET)) == 0 then
            usage_target()
            ret 2
        end
        have_target = 1
    end
    if have_template != 0 and have_target != 0 then
        ret 0
    end
    if host.host_is_tty() == 0 then
        if have_template == 0 then
            host.host_slot_set_cstr(S_FLAG_TEMPLATE, "pure-cruft".data())
        end
        if have_target == 0 then
            host.host_slot_set_cstr(S_FLAG_TARGET, "cli".data())
        end
        note_default(have_template, have_target)
        ret 0
    end
    if have_template == 0 then
        var picked: i32 = choose(1)
        if picked < 0 then
            io.println("aborted")
            ret 1
        end
        store_template(picked + 1)
    end
    if have_target == 0 then
        var picked_target: i32 = choose(2)
        if picked_target < 0 then
            io.println("aborted")
            ret 1
        end
        store_target(picked_target + 1)
    end
    ret 0
end

pub fn store_template(id: i32)
    if id == 1 then
        host.host_slot_set_cstr(S_FLAG_TEMPLATE, "pure-cruft".data())
    end
    if id == 2 then
        host.host_slot_set_cstr(S_FLAG_TEMPLATE, "cruft-with-c".data())
    end
    if id == 3 then
        host.host_slot_set_cstr(S_FLAG_TEMPLATE, "cruft-with-rust".data())
    end
end

pub fn store_target(id: i32)
    if id == 1 then
        host.host_slot_set_cstr(S_FLAG_TARGET, "cli".data())
    end
    if id == 2 then
        host.host_slot_set_cstr(S_FLAG_TARGET, "lib".data())
    end
    if id == 3 then
        host.host_slot_set_cstr(S_FLAG_TARGET, "gui".data())
    end
    if id == 4 then
        host.host_slot_set_cstr(S_FLAG_TARGET, "wasm".data())
    end
end

pub fn apply_token(p: ptr, n: i64): i32
    if host.host_starts(p, n, "std/".data()) != 0 then
        var name_n: i64 = n - 4
        var name_p: ptr = host.host_ptr_add(p, 4)
        if host.host_valid_ident(name_p, name_n) == 0 then
            usage_std()
            ret 2
        end
        add_dep(name_p, name_n, "std".data(), 3)
        ret 0
    end
    if host.host_starts(p, n, "c:".data()) != 0 then
        var lib_n: i64 = n - 2
        var lib_p: ptr = host.host_ptr_add(p, 2)
        if host.host_valid_lib(lib_p, lib_n) == 0 then
            usage_lib()
            ret 2
        end
        add_lib(lib_p, lib_n)
        ret 0
    end
    if host.host_starts(p, n, "rust:".data()) != 0 then
        var rust_n: i64 = n - 5
        var rust_p: ptr = host.host_ptr_add(p, 5)
        if host.host_valid_lib(rust_p, rust_n) == 0 then
            usage_lib()
            ret 2
        end
        add_lib(rust_p, rust_n)
        ret 0
    end
    if host.host_contains(p, n, "/".data()) != 0 or host.host_contains(p, n, "\\".data()) != 0 or host.host_starts(p, n, ".".data()) != 0 then
        if path_is_lib(p, n) != 0 then
            host.host_dirname_to(p, n, S_TEMP)
            host.host_basename_to(p, n, S_SAVED)
            host.host_strip_lib_name(S_SAVED)
            add_search(host.host_slot_ptr(S_TEMP), host.host_slot_len(S_TEMP))
            add_lib(host.host_slot_ptr(S_SAVED), host.host_slot_len(S_SAVED))
            ret 0
        end
        add_search(p, n)
        ret 0
    end
    usage_pkg()
    ret 2
end

pub fn path_is_lib(p: ptr, n: i64): i32
    if host.host_ends(p, n, ".a".data()) != 0 then
        ret 1
    end
    if host.host_ends(p, n, ".lib".data()) != 0 then
        ret 1
    end
    if host.host_ends(p, n, ".dll".data()) != 0 then
        ret 1
    end
    if host.host_ends(p, n, ".so".data()) != 0 then
        ret 1
    end
    if host.host_ends(p, n, ".dylib".data()) != 0 then
        ret 1
    end
    if host.host_ends(p, n, ".o".data()) != 0 then
        ret 1
    end
    ret 0
end

pub fn add_dep(np: ptr, nn: i64, sp: ptr, sn: i64)
    var idx: i32 = host.host_list_index(L_DEP_NAME, np, nn)
    if idx >= 0 then
        host.host_list_set(L_DEP_SRC, idx, sp, sn)
        host.host_buf_clear()
        host.host_buf_put(np, nn)
        host.host_buf_puts(" is already in [dependencies]\n".data())
        io.print(host.take())
    else
        host.host_list_add(L_DEP_NAME, np, nn)
        host.host_list_add(L_DEP_SRC, sp, sn)
        host.host_buf_clear()
        host.host_buf_puts("added dependency ".data())
        host.host_buf_put(np, nn)
        host.host_buf_puts("\n".data())
        io.print(host.take())
    end
end

pub fn add_lib(p: ptr, n: i64)
    if host.host_list_index(L_LIBS, p, n) >= 0 then
        host.host_buf_clear()
        host.host_buf_put(p, n)
        host.host_buf_puts(" is already in [link] libraries\n".data())
        io.print(host.take())
    else
        host.host_list_add(L_LIBS, p, n)
        host.host_buf_clear()
        host.host_buf_puts("added link library ".data())
        host.host_buf_put(p, n)
        host.host_buf_puts("\n".data())
        io.print(host.take())
    end
end

pub fn add_search(p: ptr, n: i64)
    if host.host_list_index(L_SEARCH, p, n) >= 0 then
        host.host_buf_clear()
        host.host_buf_put(p, n)
        host.host_buf_puts(" is already in [link] search_paths\n".data())
        io.print(host.take())
    else
        host.host_list_add(L_SEARCH, p, n)
        host.host_buf_clear()
        host.host_buf_puts("added link search path ".data())
        host.host_buf_put(p, n)
        host.host_buf_puts("\n".data())
        io.print(host.take())
    end
end
