pub extern fn host_captured_ptr(): ptr
pub extern fn host_captured_len(): i64
pub extern fn host_flush()
pub extern fn host_spin_start(msg: ptr)
pub extern fn host_spin_stop()
pub extern fn host_read_key(): i32
pub extern fn host_cursor_up(lines: i32)

pub fn eq(data: ptr, n: i64, lit: str): i32
    ret host_streq(data, n, lit.data())
end

pub fn copy_ptr(p: ptr, n: i64): String
    var s: String = alloc_string(n)
    if n > 0 and s.data() != null() then
        host_memcpy(s.data(), p, n)
        s.set_len(n)
    end
    ret s
end

pub fn take(): String
    ret copy_ptr(host_buf_ptr(), host_buf_len())
end

pub fn arg(index: i32): String
    ret copy_ptr(host_argv(index), host_argv_len(index))
end

pub fn slot_string(slot: i32): String
    ret copy_ptr(host_slot_ptr(slot), host_slot_len(slot))
end

pub fn captured_string(): String
    ret copy_ptr(host_captured_ptr(), host_captured_len())
end
